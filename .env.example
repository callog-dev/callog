# Server
PORT=3000
# api | worker | all
ROLE=all

# Operator endpoints (/admin/*): connecting Slack/Telegram, tenant admin; disabled when empty. Min 16 chars.
ADMIN_TOKEN=

# Encrypts provider secrets (bot tokens) at rest: openssl rand -base64 32
ENCRYPTION_KEY=

# Audience the GitHub Action requests for its OIDC token (default: callog)
OIDC_AUDIENCE=callog

# Postgres. Bundled one: docker compose --profile db (docs/setup.md for your own Postgres).
DATABASE_URL=postgres://notify:notify@localhost:5432/notify
# Direct (non-pooled) connection for the queue worker when DATABASE_URL goes through PgBouncer & co.
DATABASE_URL_DIRECT=
# CA certificate for a Postgres with a private CA (PEM text, or a path in DATABASE_SSL_CA_PATH)
DATABASE_SSL_CA_PATH=
# false = the operator applies migrations (node dist/db/migrate.cli.js); the server only checks them
MIGRATE_ON_START=true

# GitHub App (Settings → Developer settings → GitHub Apps). GitHub features are off until all are set.
GITHUB_APP_ID=
# Path to the downloaded .pem (keep it outside the repo), or put the PEM itself into GITHUB_APP_PRIVATE_KEY.
GITHUB_APP_PRIVATE_KEY_PATH=
GITHUB_WEBHOOK_SECRET=
# OAuth for `/notify link github`: App → Client ID / Generate client secret; callback URL = $PUBLIC_URL/oauth/github/callback
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
# URL browsers reach the server at
PUBLIC_URL=

# Slack App bot token (xoxb-…), docs/setup/slack-app-manifest.yaml
SLACK_BOT_TOKEN=
# App-level token (xapp-…) for Socket Mode; not used yet
SLACK_APP_TOKEN=

# Telegram bot token from @BotFather (connected via PUT /admin/tenants/:id/telegram)
TELEGRAM_BOT_TOKEN=

# Development: smee.io channel that the GitHub App webhook URL points to (`pnpm tunnel`).
SMEE_URL=

# docker compose --profile app: image (empty = build locally), host path of the GitHub App key (mounted into the container) and published port
CALLOG_IMAGE=
GITHUB_APP_PRIVATE_KEY_FILE=
APP_PORT=3000
