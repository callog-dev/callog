# ---- Required ----

# The address people open Callog at, e.g. https://callog.acme.dev (http://localhost:3000 to try it).
PUBLIC_URL=
# Encrypts Slack and Telegram tokens in the database: openssl rand -base64 32
# Back it up with the database: without it the stored tokens cannot be read.
ENCRYPTION_KEY=

# ---- GitHub App ----
# Leave empty on first start: open PUBLIC_URL, create the App there and paste the lines it prints.
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=

# ---- Database ----
# Leave unset with the bundled Postgres (docker compose --profile db); set it for your own
# Postgres (docs/setup.md) or when running the server outside Docker (localhost:5432).
# DATABASE_URL=postgres://notify:notify@db.internal:5432/notify?sslmode=require
# Direct (non-pooled) connection for the queue worker when DATABASE_URL goes through PgBouncer & co.
DATABASE_URL_DIRECT=
# CA certificate for a Postgres with a private CA (PEM text, or a path in DATABASE_SSL_CA_PATH)
DATABASE_SSL_CA_PATH=
# false = the operator applies migrations (node dist/db/migrate.cli.js); the server only checks them
MIGRATE_ON_START=true

# ---- Optional ----

# Operator API (/admin/*) for scripts and automation; disabled when empty. Min 16 chars.
ADMIN_TOKEN=
# Audience the GitHub Action requests for its OIDC token
OIDC_AUDIENCE=callog
# api | worker | all
ROLE=all

# ---- docker compose ----

# Release image, e.g. ghcr.io/callog-dev/callog:0.2.0; empty = build from source
CALLOG_IMAGE=
# Host port to publish
APP_PORT=3000
# Host path of a GitHub App .pem downloaded by hand, mounted into the container. Not needed when
# the key is in GITHUB_APP_PRIVATE_KEY; /dev/null mounts nothing.
GITHUB_APP_PRIVATE_KEY_FILE=/dev/null

# ---- Development ----

# smee.io channel the GitHub App webhook points to when the server runs on localhost (`pnpm tunnel`)
SMEE_URL=
